{
  "entities": {
    "UserWorkspace": {
      "title": "User Workspace",
      "description": "Private persisted FaceBot settings, hardware configuration, location, and active OLED state owned by a single verified Google user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mode": {
          "type": "string",
          "enum": ["auto", "user"]
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "coldThresholdC": {
          "type": "number"
        },
        "hotThresholdC": {
          "type": "number"
        },
        "autoSleepTimeoutSec": {
          "type": "number"
        },
        "use24HourClock": {
          "type": "boolean"
        },
        "wakeGreetingPrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "country": {
          "type": "string",
          "maxLength": 48
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "altitude": {
          "type": "number"
        },
        "timezone": {
          "type": "string",
          "maxLength": 48
        },
        "wifiSsid": {
          "type": "string",
          "maxLength": 48
        },
        "greenLedMode": {
          "type": "string",
          "enum": ["auto", "on", "blink", "off"]
        },
        "oledScheme": {
          "type": "string",
          "enum": ["ice-blue", "white", "dual-yellow-blue", "ambient"]
        },
        "animationSpeed": {
          "type": "string",
          "enum": ["slow", "normal", "fast"]
        },
        "esp32Ip": {
          "type": "string",
          "maxLength": 80
        },
        "cloudSyncEnabled": {
          "type": "boolean"
        },
        "cloudBackendType": {
          "type": "string",
          "enum": ["vercel-api", "firebase-rtdb"]
        },
        "cloudPortalUrl": {
          "type": "string",
          "maxLength": 160
        },
        "firebaseDbUrl": {
          "type": "string",
          "maxLength": 200
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firmwareVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "otaAutoCheck": {
          "type": "boolean"
        },
        "buzzerMuted": {
          "type": "boolean"
        },
        "activeFaceId": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "mode",
        "userName",
        "coldThresholdC",
        "hotThresholdC",
        "autoSleepTimeoutSec",
        "use24HourClock",
        "wakeGreetingPrefix",
        "city",
        "country",
        "latitude",
        "longitude",
        "altitude",
        "timezone",
        "wifiSsid",
        "greenLedMode",
        "oledScheme",
        "animationSpeed",
        "esp32Ip",
        "cloudSyncEnabled",
        "cloudBackendType",
        "cloudPortalUrl",
        "firebaseDbUrl",
        "deviceId",
        "firmwareVersion",
        "otaAutoCheck",
        "buzzerMuted",
        "activeFaceId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlarmRecord": {
      "title": "Alarm Record",
      "description": "Persisted ESP32 piezo buzzer alarm schedule item belonging to a user workspace.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "time": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "enabled": {
          "type": "boolean"
        },
        "days": {
          "type": "array"
        },
        "faceId": {
          "type": "number"
        },
        "melody": {
          "type": "string",
          "enum": ["classic", "gentle", "urgent"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "time",
        "label",
        "enabled",
        "days",
        "faceId",
        "melody",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReactionRecord": {
      "title": "Custom OLED Reaction",
      "description": "Saved 128x64 Touchpad pixel art bitmap stored as a compact 2048-character hex string.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "pixelsHex": {
          "type": "string",
          "minLength": 2048,
          "maxLength": 2048
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "name", "pixelsHex", "createdAt", "updatedAt"]
    },
    "InteractionRecord": {
      "title": "Daily Interaction Event",
      "description": "Persisted ESP32, OLED, Alarm, or AI Voice Agent interaction event powering the daily activity spike chart.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "hour": {
          "type": "number"
        },
        "timestampMs": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["ai-voice", "oled-face", "alarm", "hardware"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "enum": ["portal", "esp32", "voice"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "dateKey",
        "hour",
        "timestampMs",
        "category",
        "label",
        "source",
        "createdAt"
      ]
    },
    "PlaylistItemRecord": {
      "title": "Playlist Item Record",
      "description": "User-mode OLED display playlist step persisted in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": ["face", "watch", "weather", "greeting", "custom-bitmap", "custom-text"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "durationSec": {
          "type": "number"
        },
        "enabled": {
          "type": "boolean"
        },
        "faceId": {
          "type": "number"
        },
        "customReactionId": {
          "type": "string",
          "maxLength": 64
        },
        "textMessage": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "orderIndex",
        "kind",
        "label",
        "durationSec",
        "enabled",
        "faceId",
        "customReactionId",
        "textMessage",
        "createdAt",
        "updatedAt"
      ]
    },
    "GalleryRecord": {
      "title": "OLED Screenshot Gallery Item",
      "description": "Captured 128x64 OLED display canvas screenshot stored in lossless 2048-char hex format.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "screenKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "oledScheme": {
          "type": "string",
          "enum": ["ice-blue", "white", "dual-yellow-blue", "ambient"]
        },
        "pixelsHex": {
          "type": "string",
          "minLength": 2048,
          "maxLength": 2048
        },
        "capturedAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "screenKind",
        "oledScheme",
        "pixelsHex",
        "capturedAtMs",
        "createdAt"
      ]
    },
    "GifRecord": {
      "title": "Animated OLED GIF Record",
      "description": "Permanently stored 128x64 monochrome animated GIF decoded via omggif and packed into 1024-byte (2048-char hex) frames per frame in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "frameDelayMs": {
          "type": "number"
        },
        "framesHex": {
          "type": "array"
        },
        "threshold": {
          "type": "number"
        },
        "inverted": {
          "type": "boolean"
        },
        "createdAtMs": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "frameDelayMs",
        "framesHex",
        "threshold",
        "inverted",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Owner-only FaceBot workspace configuration, location, and hardware state."
    },
    "/users/{userId}/alarms/{alarmId}": {
      "schema": { "$ref": "#/entities/AlarmRecord" },
      "description": "Owner-only persisted alarm schedules synced with ESP32."
    },
    "/users/{userId}/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/ReactionRecord" },
      "description": "Owner-only saved 128x64 Touchpad pixel art reactions."
    },
    "/users/{userId}/interactions/{eventId}": {
      "schema": { "$ref": "#/entities/InteractionRecord" },
      "description": "Owner-only immutable daily ESP32 and AI voice interaction audit log."
    },
    "/users/{userId}/playlist/{itemId}": {
      "schema": { "$ref": "#/entities/PlaylistItemRecord" },
      "description": "Owner-only User-Mode OLED display playlist items."
    },
    "/users/{userId}/gallery/{shotId}": {
      "schema": { "$ref": "#/entities/GalleryRecord" },
      "description": "Owner-only captured 128x64 OLED display screenshots."
    },
    "/users/{userId}/gifs/{gifId}": {
      "schema": { "$ref": "#/entities/GifRecord" },
      "description": "Owner-only permanently stored animated 128x64 OLED GIFs (uploaded individually or extracted from ZIP packs)."
    }
  }
}
